# Python
__pycache__/
*.py[cod]
.venv/

# Runtime data (recreated by init_db on launch)
data/

# CAD assets
robot.glb

# Updater state — per machine, and the token is a credential (see app/update/)
update.json
update_token
updates/
selfcheck.log
# Qt's own warnings, per machine (app/qt_log.py)
qt_warnings.log
crash.log

# The secret folder (app/credentials.py) — every key the app is handed. Only
# its README is tracked. The Nexus event-feed preferences sit beside it.
secrets/*
!secrets/README.md
nexus.json
# Which screens are published to the pit LAN — per machine (app/webcast/)
webcast.json
# Pit setup files carry keys (app/provision.py) — made for a stick, never committed
pit-setup.json
pit-setup.json.imported
*.pitsetup.json

# OS
.DS_Store

# PyInstaller output — see DEPLOYMENT.md
build/
dist/
*.spec.bak

# The Windows libVLC runtime, fetched by tools/fetch_vlc.py (~136 MB of
# upstream VideoLAN binaries). Downloaded at build time, never committed —
# see the module docstring for why it has to be in the bundle at all.
vlc/

# Scratch data tree for tools/webcast_check.py — wiped and rebuilt each run
.webcast_check/

# Scratch tree for tools/upgrade_check.py — wiped and rebuilt each run
.upgrade_check/
# Scratch tree for tools/ai_check.py — a copy of the database, wiped each run
.ai_check/

# Sync identity and preferences — per machine, never shared (app/db/sync/)
sync.json
/sync/
# llama.cpp's server, fetched by tools/fetch_llama.py (like vlc/)
llama/
# The analysis model (5 GB, downloaded once into the data tree) and the
# engine's / MCP server's logs, from a checkout's data dir
models/
llama.log
mcp.log
ai.json

# tools/validate.py: check logs and the --app test install, rebuilt each run
.validation/
