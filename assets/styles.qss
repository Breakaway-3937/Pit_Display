/* ═══════════════════════════════════════════════════════════════════════════
   Breakaway 3937 — dark (Carbon) theme, app-wide default.
   Carbon surfaces carry the layout; one red used with intent.
   Chakra Petch = display/headline/numeric · Roboto = body/UI.
   Tokens mirror app/brand.py — keep them in sync.
   ═══════════════════════════════════════════════════════════════════════════ */

/* ── Global ─────────────────────────────────────────────────────────────── */
QWidget {
    background-color: #121013;      /* CARBON_BG */
    color: #F3F1F0;                 /* INK_DARK  */
    font-family: "Roboto";
    font-size: 13px;
}

QMainWindow { background-color: #121013; }

/* Labels are transparent so they never paint the page background over a card
   (ChamferFrame / QFrame#panel use a lighter surface fill). */
QLabel { background: transparent; }

QToolTip {
    background-color: #1D1A1C;
    color: #F3F1F0;
    border: 1px solid #332F32;
    padding: 4px 8px;
}

/* ── Panel / card containers ─────────────────────────────────────────────── */
QFrame#panel {
    background-color: #1D1A1C;      /* CARBON_SURF */
    border: 1px solid #332F32;      /* CARBON_LINE */
    border-radius: 12px;
}

QFrame#panel_accent {
    background-color: #1D1A1C;
    border: 1px solid #C82027;      /* RED */
    border-radius: 12px;
}

/* ── Type roles ──────────────────────────────────────────────────────────── */
/* Eyebrow — Chakra Petch, tracked caps, red */
QLabel#section_header {
    color: #C82027;
    font-family: "Chakra Petch";
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2px;
}

QLabel#screen_title {
    color: #FFFFFF;
    font-family: "Chakra Petch";
    font-size: 22px;
    font-weight: 700;
}

QLabel#match_label {
    color: #FFFFFF;
    font-family: "Chakra Petch";
    font-size: 36px;
    font-weight: 700;
}

QLabel#rank_number {
    color: #C82027;
    font-family: "Chakra Petch";
    font-size: 72px;
    font-weight: 700;
}

QLabel#team_number {
    color: #C82027;
    font-family: "Chakra Petch";
    font-size: 18px;
    font-weight: 700;
}

QLabel#stat_value {
    color: #F3F1F0;
    font-family: "Chakra Petch";
    font-size: 20px;
    font-weight: 600;
}

QLabel#stat_label {
    color: #A6A19E;                 /* N400 muted */
    font-size: 12px;
}

QLabel#status_ok    { color: #2E8B7F; font-weight: 600; }
QLabel#status_warn  { color: #E08A1E; font-weight: 600; }
QLabel#status_error { color: #C82027; font-weight: 600; }

/* ── Tables ──────────────────────────────────────────────────────────────── */
QTableWidget {
    background-color: #1D1A1C;
    border: none;
    gridline-color: #332F32;
    selection-background-color: #C82027;
    selection-color: #FFFFFF;
}

QTableWidget::item { padding: 6px 10px; border: none; }
QTableWidget::item:alternate { background-color: #272327; }

QHeaderView::section {
    background-color: #272327;
    color: #A6A19E;
    font-family: "Chakra Petch";
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 8px 10px;
    border: none;
    border-bottom: 1px solid #332F32;
}

/* ── Buttons (brand system §7) ───────────────────────────────────────────── */
QPushButton {
    background-color: #272327;      /* CARBON_SURF2 */
    color: #F3F1F0;
    border: 1px solid #332F32;
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 500;
}
QPushButton:hover   { background-color: #322D31; border-color: #443F3D; }
QPushButton:pressed { background-color: #1D1A1C; }
QPushButton:disabled { color: #6A6462; border-color: #272327; }

QPushButton#btn_primary {
    background-color: #C82027;
    color: #FFFFFF;
    border: none;
    font-family: "Chakra Petch";
    font-weight: 600;
}
QPushButton#btn_primary:hover   { background-color: #B01C22; }
QPushButton#btn_primary:pressed { background-color: #8E1519; }   /* Ember */

QPushButton#btn_secondary {
    background-color: transparent;
    color: #C82027;
    border: 1.5px solid #C82027;
    font-weight: 600;
}
QPushButton#btn_secondary:hover { background-color: #C82027; color: #FFFFFF; }

QPushButton#btn_success {
    background-color: transparent;
    color: #2E8B7F;
    border: 1.5px solid #2E8B7F;
    font-weight: 600;
}
QPushButton#btn_success:hover { background-color: #2E8B7F; color: #FFFFFF; }

QPushButton#btn_danger {
    background-color: transparent;
    color: #C82027;
    border: 1px solid #443F3D;
    font-weight: 600;
}
QPushButton#btn_danger:hover { background-color: #C82027; color: #FFFFFF; border-color: #C82027; }

/* ── Alliance color badges ───────────────────────────────────────────────── */
QFrame#alliance_red {
    background-color: #2A1214;
    border: 1px solid #C82027;
    border-radius: 8px;
}
QFrame#alliance_blue {
    background-color: #14182A;
    border: 1px solid #2B3A67;
    border-radius: 8px;
}

/* ── Separators ──────────────────────────────────────────────────────────── */
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #332F32; }

/* ── ScrollBars ──────────────────────────────────────────────────────────── */
QScrollBar:vertical { background: #121013; width: 8px; border: none; }
QScrollBar::handle:vertical { background: #443F3D; border-radius: 4px; min-height: 20px; }
QScrollBar::handle:vertical:hover { background: #6A6462; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: #121013; height: 8px; border: none; }
QScrollBar::handle:horizontal { background: #443F3D; border-radius: 4px; min-width: 20px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ── ComboBox ────────────────────────────────────────────────────────────── */
QComboBox {
    background-color: #272327;
    border: 1px solid #332F32;
    border-radius: 8px;
    padding: 7px 12px;
    color: #F3F1F0;
    font-family: "Chakra Petch";
    font-weight: 500;
}
QComboBox:hover { border-color: #443F3D; }
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #1D1A1C;
    border: 1px solid #332F32;
    selection-background-color: #C82027;
    selection-color: #FFFFFF;
    outline: none;
}

/* ── Tabs ────────────────────────────────────────────────────────────────── */
QTabWidget::pane { border: 1px solid #332F32; background-color: #1D1A1C; }
QTabBar::tab {
    background-color: #1D1A1C;
    color: #A6A19E;
    font-family: "Chakra Petch";
    font-weight: 500;
    padding: 10px 20px;
    border: none;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected { color: #FFFFFF; border-bottom: 2px solid #C82027; }
QTabBar::tab:hover    { color: #F3F1F0; background-color: #272327; }

/* ── Progress bar ────────────────────────────────────────────────────────── */
QProgressBar {
    background-color: #272327;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk { background-color: #C82027; border-radius: 3px; }

/* ── Inputs ──────────────────────────────────────────────────────────────── */
QLineEdit, QTextEdit {
    background-color: #272327;
    border: 1px solid #332F32;
    border-radius: 8px;
    padding: 7px 11px;
    color: #F3F1F0;
    selection-background-color: #C82027;
    selection-color: #FFFFFF;
}
QLineEdit:focus, QTextEdit:focus { border-color: #C82027; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator {
    width: 16px; height: 16px;
    border: 1px solid #443F3D;
    border-radius: 4px;
    background: #272327;
}
QCheckBox::indicator:checked { background: #C82027; border-color: #C82027; }

/* ── Dialogs ─────────────────────────────────────────────────────────────── */
QDialog { background-color: #1D1A1C; }
QMessageBox { background-color: #1D1A1C; }
