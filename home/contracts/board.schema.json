{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sync.bh-stack.com/contracts/board.schema.json",
  "title": "Analysis board",
  "description": "What the home pipeline publishes for a pit screen to paint. It mirrors app/robot/diagnostics.py's Dashboard (Reading, Subsystem, fault Reading) field for field, so the pit renders it with the diagnostics board's own painter: nothing here is layout. Travels as the `data` of a hub row {tbl: 'analysis_board', uid, op: 'upsert'}. Every number in a string field must also appear in `evidence` (the pit's 'every number is real' rule); the publisher checks that, not the model.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "title", "headline", "vitals", "evidence"],
  "properties": {
    "schema": { "const": 1 },
    "title": { "type": "string", "maxLength": 60, "description": "Picker label on the control screen, e.g. 'qm14 · battery'." },
    "session_uid": { "type": ["string", "null"], "description": "log_session uid the board is about, or null for a multi-match board." },
    "generated_at": { "type": "string", "description": "ISO-8601 UTC." },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "analyst": { "type": "string" },
        "designer": { "type": "string" }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "title", "sentence"],
      "properties": {
        "status": { "$ref": "#/$defs/status" },
        "title": { "type": "string", "maxLength": 40, "description": "The 108px line. A mechanism by name: 'Battery sag', 'All clear'." },
        "sentence": { "type": "string", "maxLength": 200, "description": "One plain sentence under it." }
      }
    },
    "vitals": {
      "type": "array",
      "maxItems": 8,
      "description": "KPI cards, worst first. Each is a Reading.",
      "items": { "$ref": "#/$defs/reading" }
    },
    "subsystems": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "maxLength": 24 },
          "stator_a": { "type": ["number", "null"] },
          "supply_a": { "type": ["number", "null"] },
          "pdh_a": { "type": ["number", "null"] },
          "temp_f": { "type": ["number", "null"] },
          "status": { "$ref": "#/$defs/status" },
          "finding": { "type": ["string", "null"], "description": "As reading.finding." },
          "note": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "faults": {
      "type": "array",
      "maxItems": 6,
      "items": { "$ref": "#/$defs/reading" }
    },
    "charts": {
      "type": "array",
      "maxItems": 4,
      "description": "Graphs the designer chose, most telling first. The designer picks the kind and names the data (`source`); the publisher fetches it through the same tools into `data`. A chart can't show a figure the database didn't return.",
      "items": { "$ref": "#/$defs/chart" }
    },
    "footer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "left": { "type": "string", "maxLength": 80 },
        "right": { "type": "string", "maxLength": 80 }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "description": "Where every figure came from: the MCP tool call and the value it returned. Filled by the pipeline, not written by the designer model.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tool", "args", "value"],
        "properties": {
          "tool": { "type": "string" },
          "args": { "type": "object" },
          "value": {}
        }
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["ok", "warn", "fault", "idle"],
      "description": "The robot's own fault flags decide 'fault' (CLAUDE.md, Diagnostics boards). A model may not invent one: 'fault' requires a fault_event in evidence. Red appears only for 'fault'; zero red is allowed, two red regions never."
    },
    "reading": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "value", "status"],
      "properties": {
        "label": { "type": "string", "maxLength": 28 },
        "value": { "type": "string", "maxLength": 12, "description": "Already formatted: '7.9', '312', 'Yes'." },
        "unit": { "type": "string", "maxLength": 8 },
        "status": { "$ref": "#/$defs/status" },
        "finding": { "type": ["string", "null"], "description": "The id of the finding this card shows. The pipeline sets `status` from that finding's severity; a model never chooses a colour." },
        "detail": { "type": "string", "maxLength": 80 },
        "series": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "description": "Which per-second series draws this card's trace. The publisher fetches it and fills `shape`; a model never writes the points.",
          "properties": {
            "session_uid": { "type": "string" },
            "device_type": { "type": "string" },
            "can_id": { "type": "integer" },
            "signal": { "type": "string" },
            "column": { "enum": ["v_min", "v_max", "v_avg"] }
          },
          "required": ["session_uid", "device_type", "can_id", "signal"]
        },
        "shape": {
          "type": "array",
          "maxItems": 120,
          "items": { "type": "number" },
          "description": "Filled by the publisher from `series`."
        }
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "title", "source"],
      "properties": {
        "kind": {
          "enum": ["line", "bars", "sessions"],
          "description": "line: one device's signal across the match (series_1s; source needs device_type, can_id, column v_min/v_max/v_avg). bars: one signal compared across devices (series_stats; column min/max/mean/last). sessions: one signal across matches (compare_sessions; source.session_uids)."
        },
        "title": { "type": "string", "maxLength": 48 },
        "unit": { "type": "string", "maxLength": 8 },
        "finding": { "type": ["string", "null"], "description": "The id of the finding it illustrates." },
        "why": { "type": "string", "maxLength": 120, "description": "The designer's reason for this chart and kind. Kept for judging models; not painted." },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["signal"],
          "properties": {
            "session_uid": { "type": ["string", "null"] },
            "session_uids": { "type": "array", "maxItems": 10, "items": { "type": "string" } },
            "signal": { "type": "string" },
            "device_type": { "type": ["string", "null"] },
            "can_id": { "type": ["integer", "null"] },
            "column": { "enum": ["v_min", "v_max", "v_avg", "min", "max", "mean", "last"] }
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "description": "Filled by the publisher from `source`; a model never writes it. One of points / bars / sessions, by kind, plus the tool call it came from.",
          "properties": {
            "tool": { "type": "string" },
            "args": { "type": "object" },
            "points": {
              "type": "array",
              "maxItems": 120,
              "items": { "type": "array", "items": { "type": "number" } },
              "description": "[t_s, value], evenly downsampled."
            },
            "bars": {
              "type": "array",
              "maxItems": 24,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value"],
                "properties": {
                  "label": { "type": "string" },
                  "device_type": { "type": "string" },
                  "can_id": { "type": "integer" },
                  "value": { "type": "number" }
                }
              }
            },
            "sessions": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["session_uid"],
                "properties": {
                  "session_uid": { "type": "string" },
                  "min": { "type": ["number", "null"] },
                  "max": { "type": ["number", "null"] }
                }
              }
            }
          }
        }
      }
    }
  }
}
